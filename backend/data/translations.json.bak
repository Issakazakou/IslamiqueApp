{
  "en": {
    "301": {
      "question": "What does the Quran's \"Tadabbur\" mean?",
      "options": [
        "Reflecting deeply on the meaning of the verses",
        "Copying the Mushaf",
        "Reciting very fast",
        "Memorizing surahs without understanding them"
      ],
      "explication": "Tadabbur means contemplating the verses to understand their meaning and put it into practice.",
      "source": "Surah Sad (38), verse 29"
    },
    "302": {
      "question": "What does \"With hardship comes ease\" (Surah Ash-Sharh) teach us?",
      "options": [
        "That all effort should be avoided",
        "That hardship never ends",
        "That hardship is followed by relief",
        "That ease comes without any trial"
      ],
      "explication": "After hardship, Allah promises relief.",
      "source": "Surah Ash-Sharh (94), verses 5-6"
    },
    "303": {
      "question": "According to Surah Ar-Ra'd, what brings peace to hearts?",
      "options": [
        "The remembrance (dhikr) of Allah",
        "Entertainment",
        "Wealth",
        "Power"
      ],
      "explication": "The remembrance of Allah (dhikr) brings peace to the hearts of believers.",
      "source": "Surah Ar-Ra'd (13), verse 28"
    },
    "304": {
      "question": "What is the central theme of Surah Al-Ikhlas?",
      "options": [
        "The rules of inheritance",
        "The oneness of Allah",
        "The stories of the prophets",
        "Fasting in Ramadan"
      ],
      "explication": "This surah affirms that Allah is One and the only one to whom we turn in everything.",
      "source": "Surah Al-Ikhlas (112)"
    },
    "305": {
      "question": "What does \"Iyyaka na'budu wa iyyaka nasta'in\" (Al-Fatiha) mean?",
      "options": [
        "You alone we worship, and You alone we ask for help",
        "Praise be to Allah, Lord of the worlds",
        "Master of the Day of Judgment",
        "Guide us to the straight path"
      ],
      "explication": "In Al-Fatiha, the believer declares exclusive worship of Allah and asks help only from Him.",
      "source": "Surah Al-Fatiha (1), verse 5"
    },
    "306": {
      "question": "What does the verse \"Allah does not burden a soul beyond its capacity\" (Al-Baqarah) teach us?",
      "options": [
        "That we must give up on all difficulty",
        "Allah only asks of us what we can bear",
        "That only the rich are tested",
        "That trials have no meaning"
      ],
      "explication": "Allah does not burden any soul beyond what it can bear.",
      "source": "Surah Al-Baqarah (2), verse 286"
    },
    "307": {
      "question": "According to Surah Al-Hujurat, who is the most honoured in the sight of Allah?",
      "options": [
        "The most righteous",
        "The most knowledgeable in genealogies",
        "The most powerful",
        "The richest"
      ],
      "explication": "A person's worth is measured by piety (taqwa), not by origin or wealth.",
      "source": "Surah Al-Hujurat (49), verse 13"
    },
    "308": {
      "question": "After the command to worship Allah alone, what conduct does Surah Al-Isra enjoin?",
      "options": [
        "Trade",
        "Kindness to parents",
        "Travel",
        "Seclusion"
      ],
      "explication": "Right after the command to worship Allah alone, the Quran commands kindness to parents.",
      "source": "Surah Al-Isra (17), verse 23"
    },
    "309": {
      "question": "What message does Surah Al-Asr give to humanity?",
      "options": [
        "Man is in loss, except those who believe and do good deeds",
        "Time does not matter",
        "All people are equal in wealth",
        "Only scholars will be saved"
      ],
      "explication": "Man is in loss, except those who believe, do good deeds, and enjoin one another to truth and patience.",
      "source": "Surah Al-Asr (103), verses 1-3"
    },
    "310": {
      "question": "What does Allah ask for in saying \"Remember Me and I will remember you\"?",
      "options": [
        "To invoke Him and mention Him often",
        "To speak to no one",
        "To travel for knowledge",
        "To fast every day"
      ],
      "explication": "Allah promises to mention the one who mentions Him.",
      "source": "Surah Al-Baqarah (2), verse 152"
    },
    "311": {
      "question": "According to Surah At-Talaq, what is promised to the one who fears Allah (taqwa)?",
      "options": [
        "A way out and provision from where he does not expect",
        "Power over others",
        "A guaranteed long life",
        "A life without trials"
      ],
      "explication": "Whoever fears Allah receives from Him a way out of difficulties and unexpected provision.",
      "source": "Surah At-Talaq (65), verses 2-3"
    },
