  "ar": {
    "301": {
      "question": "ما معنى «التدبّر» في القرآن؟",
      "options": [
        "التأمل العميق في معاني الآيات",
        "نسخ المصحف",
        "القراءة بسرعة كبيرة",
        "حفظ السور دون فهمها"
      ],
      "explication": "التدبّر هو التأمل في الآيات لفهم معانيها والعمل بها.",
      "source": "سورة ص (38)، الآية 29"
    },
    "302": {
      "question": "ماذا تعلّمنا عبارة «إنّ مع العسر يسرًا» (سورة الشرح)؟",
      "options": [
        "أنه يجب تجنب كل جهد",
        "أن الشدة لا تنتهي أبدًا",
        "أن الشدة يعقبها فرج",
        "أن اليسر يأتي دون ابتلاء"
      ],
      "explication": "بعد الشدة يعد الله بالفرج.",
      "source": "سورة الشرح (94)، الآيات 5-6"
    },
    "303": {
      "question": "بحسب سورة الرعد، ما الذي تطمئن به القلوب؟",
      "options": [
        "ذكر الله",
        "الترفيه",
        "المال",
        "السلطة"
      ],
      "explication": "ذكر الله يطمئن قلوب المؤمنين.",
      "source": "سورة الرعد (13)، الآية 28"
    },
    "304": {
      "question": "ما الموضوع الرئيس لسورة الإخلاص؟",
      "options": [
        "أحكام الميراث",
        "توحيد الله",
        "قصص الأنبياء",
        "صيام رمضان"
      ],
      "explication": "تؤكد هذه السورة أن الله أحد وأنه المقصود وحده في كل أمر.",
      "source": "سورة الإخلاص (112)"
    },
    "305": {
      "question": "ما معنى «إياك نعبد وإياك نستعين» (الفاتحة)؟",
      "options": [
        "نعبدك وحدك ونستعين بك وحدك",
        "الحمد لله رب العالمين",
        "مالك يوم الدين",
        "اهدنا الصراط المستقيم"
      ],
      "explication": "في الفاتحة يعلن المؤمن إفراد الله بالعبادة ولا يستعين إلا به.",
      "source": "سورة الفاتحة (1)، الآية 5"
    },
    "306": {
      "question": "ماذا يعلّمنا قوله تعالى «لا يكلّف الله نفسًا إلا وسعها» (البقرة)؟",
      "options": [
        "أنه يجب ترك كل صعوبة",
        "أن الله لا يكلفنا إلا ما نطيق",
        "أن الأغنياء وحدهم يُبتلون",
        "أن الابتلاءات لا معنى لها"
      ],
      "explication": "لا يكلف الله نفسًا إلا ما تطيقه.",
      "source": "سورة البقرة (2)، الآية 286"
    },
    "307": {
      "question": "بحسب سورة الحجرات، من هو الأكرم عند الله؟",
      "options": [
        "الأتقى",
        "الأعلم بالأنساب",
        "الأقوى",
        "الأغنى"
      ],
      "explication": "قيمة الإنسان بتقواه لا بأصله ولا بماله.",
      "source": "سورة الحجرات (49)، الآية 13"
    },
    "308": {
      "question": "بعد الأمر بعبادة الله وحده، أي سلوك توصي به سورة الإسراء؟",
      "options": [
        "التجارة",
        "الإحسان إلى الوالدين",
        "السفر",
        "العزلة"
      ],
      "explication": "بعد الأمر بعبادة الله وحده مباشرة يأمر القرآن بالإحسان إلى الوالدين.",
      "source": "سورة الإسراء (17)، الآية 23"
    },
    "309": {
      "question": "ما الرسالة التي تذكّر بها سورة العصر البشرية؟",
      "options": [
        "الإنسان في خسر إلا الذين آمنوا وعملوا الصالحات",
        "الوقت لا أهمية له",
        "الناس متساوون في الثروة",
